{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KamHiggs/Lidia-NDA-Patent-Attorney/schemas/evidence-block.schema.json",
  "title": "Evidence Block Schema",
  "description": "Structured provenance block for volatile facts (fees, deadlines, limits) that require verification",
  "type": "object",
  "required": [
    "registry_key",
    "values",
    "source_title",
    "source_url",
    "retrieval_method",
    "retrieval_date",
    "retrieval_proof",
    "confidence"
  ],
  "properties": {
    "registry_key": {
      "type": "string",
      "description": "Identifier matching a key in the variable_data_registry",
      "examples": [
        "US_PROVISIONAL_FILING_FEE",
        "MICRO_ENTITY_GROSS_INCOME_LIMIT",
        "USPTO_PORTAL_STATUS",
        "PCT_TIME_LIMITS"
      ]
    },
    "values": {
      "oneOf": [
        { "type": "object" },
        { "type": "string", "const": "UNKNOWN" }
      ],
      "description": "Extracted facts as structured data, or 'UNKNOWN' if evidence requirements not met",
      "examples": [
        {
          "micro_entity": "$65",
          "small_entity": "$130",
          "standard_entity": "$325",
          "currency": "USD"
        },
        "UNKNOWN"
      ]
    },
    "source_title": {
      "type": "string",
      "description": "Human-readable name of the authoritative source",
      "examples": [
        "USPTO Fee Schedule",
        "USPTO Patent Center",
        "WIPO PCT Time Limits"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Direct URL to the authoritative source",
      "examples": [
        "https://www.uspto.gov/learning-and-resources/fees-and-payment/uspto-fee-schedule"
      ]
    },
    "retrieval_method": {
      "type": "string",
      "enum": [
        "LIVE_FETCH_VERIFIED",
        "USER_PROVIDED_SOURCE",
        "MODEL_MEMORY_UNVERIFIED",
        "UNKNOWN"
      ],
      "description": "Method used to obtain the values. LIVE_FETCH_VERIFIED requires retrieval_proof."
    },
    "retrieval_date": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d{2}-\\d{2}|UNKNOWN)$",
      "description": "ISO 8601 date (YYYY-MM-DD) or 'UNKNOWN'. Must be UNKNOWN unless retrieval_method is LIVE_FETCH_VERIFIED with proof.",
      "examples": ["2026-01-15", "UNKNOWN"]
    },
    "retrieval_proof": {
      "type": "object",
      "required": ["proof_type", "proof_payload"],
      "properties": {
        "proof_type": {
          "type": "string",
          "enum": [
            "SOURCE_EXCERPT_UNDER_25_WORDS",
            "PAGE_HASH",
            "TOOL_FETCH_MARKER",
            "MAP_EMBEDDED_SOURCE_POINTER",
            "RUNTIME_TOOL_LIST",
            "CONFIG_ECHO",
            "RUNTIME_CAPABILITY_POINTER"
          ],
          "description": "Type of non-fakeable proof provided"
        },
        "proof_payload": {
          "type": "string",
          "description": "The actual proof content (excerpt, hash, pointer, etc.)"
        }
      },
      "description": "Non-fakeable proof that the retrieval occurred. Required when retrieval_method is LIVE_FETCH_VERIFIED."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "SPEC_OFFICIAL",
        "FIELD_PRACTICE",
        "INFERRED",
        "HIGGS_STANDARD",
        "DOC_CONFLICT"
      ],
      "description": "Epistemic confidence level for the values"
    },
    "notes": {
      "type": "string",
      "description": "Optional additional context or warnings"
    }
  },
  "examples": [
    {
      "registry_key": "US_PROVISIONAL_FILING_FEE",
      "values": {
        "micro_entity": "$65",
        "small_entity": "$130",
        "standard_entity": "$325",
        "currency": "USD"
      },
      "source_title": "USPTO Fee Schedule",
      "source_url": "https://www.uspto.gov/learning-and-resources/fees-and-payment/uspto-fee-schedule",
      "retrieval_method": "LIVE_FETCH_VERIFIED",
      "retrieval_date": "2026-01-15",
      "retrieval_proof": {
        "proof_type": "PAGE_HASH",
        "proof_payload": "sha256:a1b2c3d4e5f6789..."
      },
      "confidence": "SPEC_OFFICIAL"
    },
    {
      "registry_key": "US_PROVISIONAL_FILING_FEE",
      "values": "UNKNOWN",
      "source_title": "USPTO Fee Schedule",
      "source_url": "https://www.uspto.gov/learning-and-resources/fees-and-payment/uspto-fee-schedule",
      "retrieval_method": "UNKNOWN",
      "retrieval_date": "UNKNOWN",
      "retrieval_proof": {
        "proof_type": "CONFIG_ECHO",
        "proof_payload": "LIVE_FETCH_AVAILABLE=NO"
      },
      "confidence": "SPEC_OFFICIAL",
      "notes": "Live fetch unavailable; user must verify current fees at source URL"
    }
  ]
}
